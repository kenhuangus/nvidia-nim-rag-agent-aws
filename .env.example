# NVIDIA NIM Configuration
NIM_INFERENCE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your_nvidia_api_key_here
NIM_MODEL=llama-3.1-nemotron-nano-8b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Vector Database
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=documents

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Agent Configuration
MAX_ITERATIONS=10
TEMPERATURE=0.7
MAX_TOKENS=2048

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_account_id
EKS_CLUSTER_NAME=nim-rag-agent-cluster

# Logging
LOG_LEVEL=INFO
